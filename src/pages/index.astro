---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Problema from '../components/Problema.astro';
import Programa from '../components/Programa.astro';
import ParaQuien from '../components/ParaQuien.astro';
import Plataformas from '../components/Plataformas.astro';
import Casos from '../components/Casos.astro';
import Agentes from '../components/Agentes.astro';
import PorQue from '../components/PorQue.astro';
import Faq from '../components/Faq.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
---

<Base>
  <Nav />
  <main id="contenido">
    <Hero />
    <Problema />
    <Programa />
    <ParaQuien />
    <Plataformas />
    <Casos />
    <Agentes />
    <PorQue />
    <Faq />
    <Contacto />
  </main>
  <Footer />
</Base>
