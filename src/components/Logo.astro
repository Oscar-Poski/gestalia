---
interface Props {
  oscuro?: boolean;
  class?: string;
}
const { oscuro = false, class: clase = '' } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2 font-display text-2xl font-bold tracking-tight', clase]}>
  <svg width="22" height="22" viewBox="0 0 32 32" aria-hidden="true">
    <rect x="3" y="3" width="12" height="12" rx="3" fill="currentColor" />
    <rect x="17" y="3" width="12" height="12" rx="3" fill="currentColor" />
    <rect x="3" y="17" width="12" height="12" rx="3" fill="currentColor" />
    <rect x="17" y="17" width="12" height="12" rx="3" fill={oscuro ? '#6E8BFF' : '#2453FF'} />
  </svg>
  <span>gestal<span class={oscuro ? 'text-azul-claro' : 'text-azul'}>ia</span></span>
</span>
