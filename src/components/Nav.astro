---
import Logo from './Logo.astro';
import { site, whatsappUrl } from '../config';

const links = [
  { href: '#programa', label: 'Programa' },
  { href: '#para-quien', label: 'Para quién' },
  { href: '#casos', label: 'Casos' },
  { href: '#agentes', label: 'Agentes de IA' },
  { href: '#faq', label: 'FAQ' },
];
---

<header class="sticky top-0 z-40 border-b border-linea/70 bg-blanco/85 backdrop-blur">
  <nav class="container-g flex h-16 items-center justify-between gap-4" aria-label="Principal">
    <a href="/" aria-label="Gestalia, inicio"><Logo /></a>
    <ul class="hidden items-center gap-6 text-sm lg:gap-8 font-medium text-pizarra lg:flex">
      {links.map((l) => <li><a href={`/${l.href}`} class="hover:text-tinta">{l.label}</a></li>)}
    </ul>
    <div class="flex items-center gap-2">
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener"
        class="grid h-10 w-10 place-items-center rounded-full border border-linea text-tinta hover:border-tinta"
        aria-label="Escríbenos por WhatsApp"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.1 5.1 0 0 0 1.1 2.7 11.7 11.7 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"/></svg>
      </a>
      <a href={site.bookingUrl} class="btn-primario hidden !px-5 !py-2 text-sm sm:inline-flex">Agenda una llamada</a>
    </div>
  </nav>
</header>
