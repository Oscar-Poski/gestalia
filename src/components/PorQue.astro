---
import { fundador } from '../config';

const razones = [
  { titulo: 'Persona por persona', texto: 'No es un webinar: nos sentamos con cada quien a revisar su trabajo real.' },
  { titulo: 'Tu equipo se queda con la habilidad', texto: 'Aprenden a crear y mejorar sus propias skills. Cero dependencia.' },
  { titulo: 'Independientes de la plataforma', texto: 'Recomendamos Claude, Gemini o ChatGPT según lo que encaja con tu stack.' },
  { titulo: 'Tus datos, protegidos', texto: 'Planes empresariales que no entrenan con tu información por defecto, accesos controlados y aviso de privacidad.' },
  { titulo: 'Practicantes, no teóricos', texto: 'Construimos y operamos nuestro propio software con IA.' },
];
---

<section id="nosotros" class="scroll-mt-16 py-20 md:py-28">
  <div class="container-g grid gap-12 lg:grid-cols-[1.3fr_1fr]">
    <div>
      <div class="reveal">
        <p class="etiqueta">07 — Por qué Gestalia</p>
        <h2 class="mt-4 text-[clamp(2rem,4.5vw,3rem)]">Gestalt + IA: <span class="enfasis">el todo es más que la suma de sus partes</span>.</h2>
      </div>
      <ul class="mt-10 divide-y divide-linea border-y border-linea">
        {razones.map((r) => (
          <li class="reveal grid gap-1 py-5 sm:grid-cols-[14rem_1fr] sm:gap-6">
            <h3 class="font-display text-lg font-bold">{r.titulo}</h3>
            <p class="text-pizarra">{r.texto}</p>
          </li>
        ))}
      </ul>
    </div>

    <aside class="reveal card h-fit p-6 sm:p-8" aria-label="Sobre el fundador">
      {fundador.foto
        ? <img src={fundador.foto} alt={fundador.nombre} width="96" height="96" class="h-24 w-24 rounded-2xl object-cover" loading="lazy" />
        : <div class="grid h-24 w-24 place-items-center rounded-2xl bg-hielo font-display text-3xl font-bold text-azul" aria-hidden="true">{fundador.iniciales}</div>}
      <p class="etiqueta mt-6">{fundador.rol}</p>
      <h3 class="mt-1 text-2xl">{fundador.nombre}</h3>
      {fundador.bio.map((p) => <p class="mt-3 text-pizarra">{p}</p>)}
    </aside>
  </div>
</section>
